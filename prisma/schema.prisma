// ORBITAL — AI Project Management workspace
// Prisma schema (SQLite). Mirrors the domain model of the reference app:
// login users, AI-known assignee persons, invited workspace members/agents,
// goals, tasks, task check-in updates, agent activity log, workspace settings.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  avatarColor  String   @default("#996CE4")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// Assignee entities — the people the AI plans reference (seeded demo people)
// plus one linked Person per login user so "My Tasks" resolves.
model Person {
  id          String   @id @default(cuid())
  name        String
  avatarColor String   @default("#996CE4")
  userId      String?  @unique
  createdAt   DateTime @default(now())

  tasks Task[]

  @@index([name])
}

// Invited workspace members (humans) and configured AI agents.
// Starts empty in a fresh workspace, like the reference app.
model TeamMember {
  id          String   @id @default(cuid())
  name        String
  email       String?
  role        String?
  avatarColor String   @default("#996CE4")
  kind        String   @default("human") // "human" | "agent"
  agentRole   String? // e.g. "Project Assistant"
  createdAt   DateTime @default(now())
}

model Goal {
  id          String    @id @default(cuid())
  title       String
  description String?
  status      String    @default("active") // active | done | draft | paused
  targetDate  DateTime?
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tasks Task[]

  @@index([status])
}

model Task {
  id             String    @id @default(cuid())
  goalId         String
  title          String
  description    String?
  status         String    @default("pending") // pending | in_progress | blocked | need_help | done
  deadline       DateTime?
  assigneeId     String?
  estimatedHours Float?
  createdByAi    Boolean   @default(false)
  sortOrder      Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  goal     Goal         @relation(fields: [goalId], references: [id], onDelete: Cascade)
  assignee Person?      @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
  updates  TaskUpdate[]

  @@index([goalId])
  @@index([assigneeId])
  @@index([status])
}

model TaskUpdate {
  id        String   @id @default(cuid())
  taskId    String
  status    String // on_track | blocked | need_help | done
  note      String?
  createdAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
}

model ActivityLog {
  id        String   @id @default(cuid())
  type      String // task_assigned | tasks_generated | goal_created | goal_completed | status_update | member_invited | agent_created | task_created | task_deleted | goal_deleted | settings_updated
  message   String
  detail    String?
  taskId    String?
  goalId    String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model WorkspaceSetting {
  id            String @id @default("singleton")
  name          String @default("My Team")
  workStart     String @default("09:00")
  workEnd       String @default("17:00")
  pingFrequency String @default("once_daily") // once_daily | twice_daily | weekly
  aiTone        String @default("friendly") // friendly | professional | concise
}
